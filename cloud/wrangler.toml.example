name = "road-to-p1-media-cloud"
main = "worker.js"
compatibility_date = "2026-09-22"

[[r2_buckets]]
binding = "MEDIA"
bucket_name = "road-to-p1-media"

[[d1_databases]]
binding = "DB"
database_name = "road-to-p1-media"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[vars]
ALLOWED_ORIGIN = "https://felixbruno1973-design.github.io"
